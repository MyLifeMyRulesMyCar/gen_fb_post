# Server
PORT=3000

# OpenRouter
OPENROUTER_API_KEY=
LLM_MODEL=openrouter/free

# Kimi (Moonshot) - writes the AI Suggest copy. Text only: Kimi has no image model.
# The default host is https://api.moonshot.cn/v1; keys issued for other regions
# answer 401 there, so set KIMI_BASE_URL=https://api.moonshot.ai/v1 if needed.
KIMI_API_KEY=
KIMI_MODEL=kimi-k3.1-pro
KIMI_BASE_URL=

# Google Gemini (image generation)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Optional: local proxy for Google hosts, auto-detected on 127.0.0.1:7890/7891/10809
GEMINI_PROXY=

# AI Horde (free image provider, works with no key)
# Optional: your own key raises priority and allows larger images
HORDE_API_KEY=

# Cloudflare Workers AI (free 10,000 neurons/day, needs a free account)
CF_ACCOUNT_ID=
CF_API_TOKEN=

# BytePlus ModelArk / Seedream (2K poster art)
# Create the key at console.byteplus.com -> ModelArk -> API keys, then activate
# the model you want (Seedream image models are not usable until activated).
BYTEPLUS_API_KEY=
BYTEPLUS_IMAGE_MODEL=seedream-5-0-260128

# Brand assets folder used by the image tab
BRAND_ROOT=D:\elephantronics-com
